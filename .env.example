# Copy to .env.local for local development. Never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=

# Cron
CRON_SECRET=

# SMTP / email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
AUTH_FROM_EMAIL=
PAYROLL_FROM_EMAIL=

# AI Gateway
AI_GATEWAY_API_KEY=

# Upstash Redis (rate limit + FX cache) — Vercel: wodus-admin preview+production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional FX cache TTL seconds (default 600 = 10 min)
# FX_CACHE_TTL_SECONDS=600
